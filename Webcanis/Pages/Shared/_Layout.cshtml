<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Webcanis builds custom web applications for businesses. We work with you to create useful, intuitive solutions that are ready to evolve." />
    <meta name="theme-color" content="#d9d9d9" />
    <title>@ViewData["Title"] — Webcanis</title>
    <link rel="icon" type="image/png" href="~/images/webcanis-logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/story.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/process.css" asp-append-version="true" />
    <script type="importmap">
        { "imports": { "three": "@Url.Content("~/lib/three/build/three.module.min.js")" } }
    </script>
</head>
<body>
    @RenderBody()
    <script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
