@page
@{
    ViewData["Title"] = "Web applications for your business";
}

<a class="visually-hidden-focusable skip-link" href="#main-content">Skip to content</a>
<a class="visually-hidden-focusable skip-link" href="#proceso">Skip animated sections</a>
<header class="site-header">
    <nav class="navbar navbar-expand-lg py-0" aria-label="Main navigation">
        <div class="container-fluid px-0">
            <a class="navbar-brand d-flex align-items-end m-0 p-0" href="#inicio" aria-label="Webcanis home">
                <img class="brand-mark" src="~/images/webcanis-logo.png" width="43" height="46" alt="" />
                <span class="brand-name">WEBCANIS</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse justify-content-end" id="main-navigation">
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" href="#soluciones">Solutions</a></li>
                    <li class="nav-item"><a class="nav-link" href="#proyectos">Projects</a></li>
                    <li class="nav-item"><a class="nav-link" href="#proceso">How we work</a></li>
                    <li class="nav-item"><a class="nav-link nav-contact" href="#contacto">Let’s talk</a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main id="main-content" tabindex="-1">
    <div class="showcase-journey">
        <div class="story-stage">
            <div class="story-canvas">
                <div class="laptop-stage" aria-hidden="true" data-model-url="@Url.Content("~/models/generic-laptop.glb")"></div>
                <section class="story-panel home-panel" id="inicio" aria-labelledby="hero-title">
                    <div class="scene-copy">
                        <div class="hero-copy">
                            <p class="story-eyebrow">Web development for businesses</p>
                            <h1 id="hero-title">You know your business<span>.</span><br />We help you build<br /><span>what comes next.</span></h1>
                            <p class="hero-description">We work with you to turn your needs into a <strong>web application</strong> that’s useful, intuitive and ready to evolve.</p>
                            <div class="hero-actions d-flex flex-wrap align-items-center">
                                <a class="btn btn-primary rounded-pill" href="#contacto">Tell us about your idea</a>
                                <a class="text-link" href="#proceso">How we work</a>
                            </div>
                        </div>
                        <div class="hero-callout" aria-hidden="true">
                            <div class="callout-marker hero-callout-marker">
                                <span class="callout-line-slot"><img src="~/images/story/hero-callout-line.svg" alt="" /></span>
                                <img class="callout-dot" src="~/images/story/hero-callout-dot.svg" alt="" />
                            </div>
                            <p>Ideas taking shape.<br />Solutions that connect.</p>
                        </div>
                    </div>
                    <div class="scene-art" data-model-pose="home" aria-hidden="true"></div>
                </section>

                <section class="story-panel solutions-panel" id="soluciones" aria-labelledby="solutions-title">
                    <div class="scene-copy">
                        <div class="solutions-heading">
                            <h2 id="solutions-title">Technology that<br />understands <span>your business.</span></h2>
                        </div>
                        <div class="solutions-copy">
                            <p class="solutions-intro">Every business works differently. We build with your process in mind to make a difference.</p>
                            <div class="service-list d-flex flex-column">
                                <article class="service-item is-featured"><span class="item-number" aria-hidden="true">01</span><div><h3><button type="button" class="service-select stretched-link" aria-pressed="true" data-screen-image="@Url.Content("~/images/solutions/example1.png")">Custom web applications</button></h3><p>Tools to organize your operations, reduce manual tasks, and keep track of your team’s work.</p></div></article>
                                <article class="service-item"><span class="item-number" aria-hidden="true">02</span><div><h3><button type="button" class="service-select stretched-link" aria-pressed="false" data-screen-image="@Url.Content("~/images/solutions/example2.png")">Platforms and portals</button></h3><p>Dedicated spaces for your customers, suppliers, and team to access information and manage requests.</p></div></article>
                                <article class="service-item"><span class="item-number" aria-hidden="true">03</span><div><h3><button type="button" class="service-select stretched-link" aria-pressed="false" data-screen-image="@Url.Content("~/images/solutions/example3.png")">Integrations and automation</button></h3><p>We connect your tools and information flows so your team spends less time on repetitive tasks.</p></div></article>
                            </div>
                            <p class="visually-hidden" id="solution-preview-status" role="status"></p>
                        </div>
                        <a class="text-link solutions-contact" href="#contacto">Let’s talk about what you need <img class="down-arrow" src="~/images/story/arrow-down.svg" alt="" /></a>
                        <div class="solutions-callout" aria-hidden="true"><p>Design concepts</p><div class="callout-marker solutions-callout-marker"><span class="callout-line-slot"><img src="~/images/story/callout-line.svg" alt="" /></span><img class="callout-dot" src="~/images/story/callout-dot.svg" alt="" /></div></div>
                    </div>
                    <div class="scene-art" data-model-pose="solutions" aria-hidden="true"></div>
                </section>

                <section class="story-panel projects-panel" id="proyectos" aria-labelledby="projects-title">
                    <div class="scene-copy">
                        <div class="projects-heading"><h2 id="projects-title">From a business need to a<br /><span>practical solution.</span></h2><p>Here’s what a project for your business could look like. These scenarios illustrate possible solutions, rather than client case studies.</p></div>
                        <div class="project-grid row g-3">
                            <div class="col-md-4"><article class="project-example h-100"><div class="project-meta d-flex flex-wrap align-items-center"><span class="project-label">Solution concept</span><span class="project-type">Customer experience</span></div><h3>Bring your customers closer</h3><dl class="project-brief"><dt>The need</dt><dd>Requests and documents are scattered across emails and conversations.</dd><dt>The approach</dt><dd>A portal to access documents, submit requests, and track progress in one place.</dd></dl></article></div>
                            <div class="col-md-4"><article class="project-example h-100"><div class="project-meta d-flex flex-wrap align-items-center"><span class="project-label">Solution concept</span><span class="project-type">Internal operations</span></div><h3>Keep your team in sync</h3><dl class="project-brief"><dt>The need</dt><dd>Tracking work relies on spreadsheets and manually updating information.</dd><dt>The approach</dt><dd>An application with shared tasks, owners, and statuses to coordinate day-to-day work.</dd></dl></article></div>
                            <div class="col-md-4"><article class="project-example h-100"><div class="project-meta d-flex flex-wrap align-items-center"><span class="project-label">Solution concept</span><span class="project-type">Systems integration</span></div><h3>Connect the tools your business relies on</h3><dl class="project-brief"><dt>The need</dt><dd>Your team copies information between sales, billing, and operations tools, leading to duplicate work and inconsistent records.</dd><dt>The approach</dt><dd>An integration that keeps key information in sync and automates routine handoffs, with a shared view of updates and exceptions.</dd></dl></article></div>
                        </div>
                    </div>
                    <div class="scene-art" data-model-pose="projects" aria-hidden="true"></div>
                </section>
            </div>
        </div>
    </div>

    <section class="process-section" id="proceso" aria-labelledby="process-title">
        <div class="process-stage">
            <div class="process-canvas">
                <div class="process-heading">
                    <h2 id="process-title">A clear process.<br />A team <span>by your side.</span></h2>
                    <p>Shared decisions and progress you can review. So you know what we’re building and why.</p>
                </div>
                <div class="process-illustration" aria-hidden="true" data-animation-url="@Url.Content("~/images/process/webcanis-process-morph.svg")">
                    <img class="process-art-fallback" src="~/images/process/webcanis-process-morph-reduced-motion.svg" alt="" />
                    <object type="image/svg+xml" tabindex="-1" title="Process illustration"></object>
                </div>
                <div class="process-tabs d-flex" aria-label="How we work stages">
                    <button class="process-tab" type="button" id="process-understand" aria-controls="process-detail-understand"><span>01</span> Understand</button>
                    <button class="process-tab" type="button" id="process-design" aria-controls="process-detail-design"><span>02</span> Design</button>
                    <button class="process-tab" type="button" id="process-develop" aria-controls="process-detail-develop"><span>03</span> Develop</button>
                    <button class="process-tab" type="button" id="process-launch" aria-controls="process-detail-launch"><span>04</span> Launch</button>
                </div>
                <div class="process-details">
                    <div class="process-detail" id="process-detail-understand" aria-labelledby="process-understand"><p>We listen to your team, explore your current process, and define the problem we need to solve.</p></div>
                    <div class="process-detail" id="process-detail-design" aria-labelledby="process-design"><p>We map out flows and screens so you can explore how the solution will work before development starts.</p></div>
                    <div class="process-detail" id="process-detail-develop" aria-labelledby="process-develop"><p>We build in stages, test the workflows, and review progress with you to make adjustments along the way.</p></div>
                    <div class="process-detail" id="process-detail-launch" aria-labelledby="process-launch"><p>We prepare for launch and work with you on what your team needs to start using the application.</p></div>
                </div>
                <div class="process-line" aria-hidden="true"><img src="~/images/process/stage-line.svg" alt="" /></div>
            </div>
        </div>
    </section>

    <section class="page-section about-section" id="nosotros" aria-labelledby="about-title">
        <div class="container site-container"><div class="row g-4 g-lg-5">
            <div class="col-lg-6"><h2 id="about-title">A team you <span>can build with.</span></h2></div>
            <div class="col-lg-6 about-copy">
                <p class="about-lead">We’re a web application development team. We care about understanding how your business works and creating tools that make sense to the people who use them.</p>
                <p>We work with you to connect business decisions with product decisions. Through direct communication, shared goals, and room to ask questions.</p>
                <a class="text-link" href="#contacto">Let’s start with a conversation <span aria-hidden="true">↗</span></a>
            </div>
        </div></div>
    </section>

    <section class="page-section contact-section" id="contacto" aria-labelledby="contact-title">
        <div class="container site-container"><div class="row g-4 g-lg-5">
            <div class="col-lg-6">
                <h2 id="contact-title">What does <span>your business need?</span></h2>
                <p class="section-intro">Tell us what you want to achieve or which process you’d like to improve. We can start there.</p>
                <p class="contact-note" id="contact-status">Our contact form is coming soon. It’s currently unavailable and does not collect or send any information.</p>
            </div>
            <div class="col-lg-6">
                @* No destination supplied: enable these fields only when sending is implemented. *@
                <form aria-label="Tell us about your project" aria-describedby="contact-status"><fieldset disabled>
                    <legend class="visually-hidden">Contact and project details</legend>
                    <div class="row g-3">
                        <div class="col-sm-6"><label class="form-label" for="contact-name">Your name</label><input class="form-control" id="contact-name" type="text" autocomplete="name" /></div>
                        <div class="col-sm-6"><label class="form-label" for="contact-company">Company</label><input class="form-control" id="contact-company" type="text" autocomplete="organization" /></div>
                        <div class="col-12"><label class="form-label" for="contact-email">Work email</label><input class="form-control" id="contact-email" type="email" autocomplete="email" /></div>
                        <div class="col-12"><label class="form-label" for="contact-message">What would you like to solve?</label><textarea class="form-control" id="contact-message" rows="4" aria-describedby="message-help"></textarea><p class="form-text" id="message-help">Your current process, business need, or the idea you have in mind.</p></div>
                        <div class="col-12"><button class="btn btn-primary rounded-pill" type="button" disabled>Tell us about your idea <span aria-hidden="true">↗</span></button></div>
                    </div>
                </fieldset></form>
            </div>
        </div></div>
    </section>
</main>

<footer class="site-footer">
    <div class="container site-container d-flex flex-wrap justify-content-between align-items-center gap-4">
        <div><span class="footer-brand">WEBCANIS</span><p class="mb-0">Web applications. Working relationships built on clarity.</p></div>
        <nav class="d-flex flex-wrap gap-4" aria-label="Footer navigation"><a href="#nosotros">Our team</a><a href="#contacto">Contact</a><a href="#inicio">Back to top <span aria-hidden="true">↑</span></a></nav>
        <p class="footer-copyright mb-0">© @DateTime.Now.Year Webcanis</p>
    </div>
</footer>
